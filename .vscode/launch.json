{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "foo",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "bootstrap certs",
      "presentation": {
        "group": "hopscotch",
        "panel": "dedicated"
      },
      "args": ["--config", "examples/hub/foo.yaml"]
    },
    {
      "name": "bar",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "bootstrap certs",
      "presentation": {
        "group": "hopscotch",
        "panel": "dedicated"
      },
      "args": ["--config", "examples/hub/bar.yaml"]
    },
    {
      "name": "baz",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "bootstrap certs",
      "presentation": {
        "group": "hopscotch",
        "panel": "dedicated"
      },
      "args": ["--config", "examples/hub/baz.yaml"]
    },
    {
      "name": "foo (tun)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "asRoot": true,
      "program": "${workspaceFolder}/hopscotch",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "tun debug prep",
      "presentation": {
        "group": "hopscotch-tun",
        "panel": "dedicated"
      },
      "args": ["--config", "examples/hub/foo.yaml", "--tun"]
    },
    {
      "name": "chain-100",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/chain",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": {
        "group": "hopscotch",
        "panel": "dedicated"
      },
      "args": ["-n", "100"]
    },
    {
      "name": "diamond",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/diamond",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": {
        "group": "hopscotch",
        "panel": "dedicated"
      },
      "args": ["-width", "8", "-depth", "12"]
    },
    {
      "name": "cycle",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/cycle",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": {
        "group": "hopscotch",
        "panel": "dedicated"
      },
      "args": ["-hop-limit", "64", "-max-ttl", "24"]
    },
    {
      "name": "cycle (force-loop keys)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/cycle",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": {
        "group": "hopscotch",
        "panel": "dedicated"
      },
      "args": ["-force-loop", "-hop-limit", "32", "-max-ttl", "24"]
    }
  ],
  "compounds": [
    {
      "name": "foo → bar ← baz",
      "configurations": ["bar", "baz", "foo"],
      "preLaunchTask": "bootstrap certs",
      "stopAll": true,
      "presentation": {
        "group": "hopscotch",
        "order": 1
      }
    },
    {
      "name": "foo → bar ← baz (tun)",
      "configurations": ["bar", "baz", "foo (tun)"],
      "preLaunchTask": "tun debug prep",
      "stopAll": true,
      "presentation": {
        "group": "hopscotch-tun",
        "order": 2
      }
    }
  ]
}
